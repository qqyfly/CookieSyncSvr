# CookieSyncSvr Configuration (/etc/cookiesyncsvr/config.env)

# HTTP Listen Address (use 127.0.0.1:8080 when behind Nginx/Caddy reverse proxy)
LISTEN_ADDR=127.0.0.1:8080

# Storage Backend:
# - For local Arch Linux debugging or single-file storage:
#   DB_DRIVER=sqlite
#   DATABASE_URL=/var/lib/cookiesyncsvr/cookiesync.db
# - For Debian VPS with PostgreSQL installed:
#   DB_DRIVER=postgres
#   DATABASE_URL=postgres://cookiesync:password@127.0.0.1:5432/cookiesync?sslmode=disable
DB_DRIVER=sqlite
DATABASE_URL=/var/lib/cookiesyncsvr/cookiesync.db

# Optional API Key shared between Chrome Extension and Python Client
# Leave empty to disable auth during local debugging
API_KEY=

# Optional passphrase for AES-256-GCM encryption of cookie values at rest
ENCRYPTION_KEY=

# Allowed CORS Origins (comma-separated, e.g. chrome-extension://<id> or *)
CORS_ALLOWED_ORIGINS=*

# Optional MQTT Broker Notification (leave MQTT_BROKER_URL empty to disable)
MQTT_BROKER_URL=
MQTT_TOPIC=cookiesync/updated
MQTT_USERNAME=
MQTT_PASSWORD=
